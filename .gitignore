# ──────────────────────────────────────────────
# StatAudit Pro — Root GitIgnore Rules
# ──────────────────────────────────────────────

# Secrets & Environment variables
.env
.env.local
.env.*.local

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints
.pytest_cache/
.coverage
htmlcov/

# Local data uploads (Excel/CSV test sheets are kept local, only engine structures committed)
*.xlsx
*.csv
*.xls

# Frontend dependencies & Vite caching
node_modules/
.vite/

# Operating System artifacts
.DS_Store
Thumbs.db
